    {"id": "flujo_precio", "hoja": "flujo", "filas": [31, 31], "dimension": "especie", "agrega": "plantacion"},
    {"id": "flujo_costo_ha", "hoja": "flujo", "filas": [33, 33], "dimension": "especie", "agrega": "plantacion"},
    {"id": "flujo_costo_kg", "hoja": "flujo", "filas": [35, 35], "dimension": "especie", "agrega": "plantacion"},
    {"id": "flujo_margen", "hoja": "flujo", "filas": [37, 37], "dimension": "especie", "agrega": "plantacion"},
    {"id": "flujo_ingresos", "hoja": "flujo", "filas": [42, 42], "dimension": "especie", "agrega": "plantacion"},
    {"id": "flujo_costos", "hoja": "flujo", "filas": [44, 44], "dimension": "especie", "agrega": "plantacion"},

    {"id": "secciones_supuestos", "hoja": "supuestos", "filas": [21, 26], "dimension": "especie",
