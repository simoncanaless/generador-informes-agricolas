                  "E": "iii_iv_secano_ha", "F": "v_vi_secano_ha", "G": "vii_viii_secano_ha",
                  "K": "topografia"}},
    {"id": "fuentes", "hoja": "recursos", "filas": [24, 24], "dimension": "fuente",
