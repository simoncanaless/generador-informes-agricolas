     "pisa_formula": ["A", "H", "I"],
     "nota": "A, H e I traen formula en el molde (=A13, =G24, =H24): si el dato existe, manda el dato"},
    {"id": "riego", "hoja": "recursos", "filas": [33, 37], "dimension": "riego",
     "celdas": {"B33": "unidad_predial", "J35": "capacidad_tranques_m3"},
     "pisa_formula": ["B33"],
     "nota": "un bloque por unidad predial con plantaciones; B33 =A24 en el molde"},
    {"id": "riego_especies", "hoja": "recursos", "filas": [35, 35], "dimension": "riego_especie",
     "dentro_de": "riego", "columnas_de_afuera": ["I", "J", "K", "L", "M"],
     "columnas": {"C": "sistema_riego"}},

    {"id": "plantaciones", "hoja": "plantaciones", "filas": [7, 7], "dimension": "plantacion",
     "columnas": {"A": "especie", "B": "variedad", "C": "anio", "D": "royalty", "E": "superficie_ha",
                  "F": "conduccion", "G": "predio", "H": "riego", "I": "estatus", "J": "densidad",
