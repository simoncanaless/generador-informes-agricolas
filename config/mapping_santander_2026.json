    {"id": "filas_supuestos", "hoja": "supuestos", "filas": [24, 24], "dimension": "plantacion",
     "dentro_de": "secciones_supuestos",
     "columnas": {"E": "pct_exportacion", "F": "precio_exportacion_usd_kg",
                  "G": "precio_exportacion_siguientes_usd_kg", "H": "precio_mercado_interno_usd_kg",
                  "I": "costo_fijo_usd_ha", "J": "costo_variable_usd_kg",
                  "K": "rendimiento_1", "L": "rendimiento_2", "M": "rendimiento_3", "N": "rendimiento_4",
                  "O": "rendimiento_5", "P": "rendimiento_6", "Q": "rendimiento_7", "R": "rendimiento_8",
                  "S": "costo_formacion_1_usd_ha", "T": "costo_formacion_2_usd_ha",
                  "U": "costo_fijo_formacion_3_usd_ha", "V": "costo_variable_formacion_3_usd_kg"}},

    {"id": "especies_anexo1", "hoja": "anexo1", "filas": [5, 5], "dimension": "especie",
     "columnas": {"A": "nombre", "B": "produccion_total_kg", "C": "unidad", "D": "pct_exportacion",
                  "E": "ventas_exportacion_pesos", "F": "ventas_mercado_interno_pesos",
                  "H": "costos_directos_pesos"}},
    {"id": "especies_conciliacion", "hoja": "conciliacion", "filas": [23, 23], "dimension": "especie"}
  ],

  "columnas_repetidas": [
