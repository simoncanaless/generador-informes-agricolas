                  "H": "packing", "I": "proceso_exportacion", "J": "periodo_cosecha",
                  "K": "periodo_liquidaciones"}},

    {"id": "bloques", "hoja": "flujo", "filas": [8, 17], "dimension": "plantacion"},
    {"id": "flujo_superficie", "hoja": "flujo", "filas": [25, 25], "dimension": "especie",
