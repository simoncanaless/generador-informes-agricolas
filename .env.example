# Copiar a .env y rellenar. El .env NUNCA se versiona (ver .gitignore).

# --- Gemini -----------------------------------------------------------------
# Una o varias claves separadas por coma. Con varias, el router agota los
# modelos de la primera antes de pasar a la siguiente.
GEMINI_API_KEYS=tu-clave-aqui

# Cadena de modelos en orden de preferencia. Cuando uno agota su cuota (429)
# el router pasa automaticamente al siguiente sin cortar la peticion.
# Verificar con: python scripts/probar_ia.py --cadena
# Con plan de pago, anteponer un Pro: gemini-3.1-pro-preview,gemini-3.6-flash,...
GEMINI_MODELOS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest

# Segundos de castigo tras un 429 sin retryDelay. Escala x4 en cada reintento
# fallido del mismo modelo hasta GEMINI_COOLDOWN_MAXIMO.
GEMINI_COOLDOWN_BASE=60
GEMINI_COOLDOWN_MAXIMO=3600

# Reintentos sobre el MISMO modelo ante errores transitorios (503/500).
GEMINI_REINTENTOS_TRANSITORIOS=2
GEMINI_TIMEOUT_SEGUNDOS=120

# --- Base de datos ----------------------------------------------------------
# PostgreSQL. Si se deja vacio, el sistema guarda en archivos JSON dentro de
# data/almacen/ y sigue funcionando igual (con menos garantias de concurrencia).
#
# Formato: postgresql+asyncpg://usuario:contrasena@host:puerto/base
# Si la contrasena lleva @ : / o #, hay que codificarla (@ -> %40).
DATABASE_URL=postgresql+asyncpg://postgres:TU_CONTRASENA@localhost:5432/fitogreen

# Crea la base y las tablas al arrancar si no existen. Comodo en desarrollo;
# en produccion se hace con las migraciones de Alembic.
DB_CREAR_AL_ARRANCAR=true
DB_ECHO=false

# --- API --------------------------------------------------------------------
API_TITULO=Fitogreen Tasaciones API
API_ENTORNO=desarrollo
# Vacio: la pagina y la API salen del mismo servidor (ver config/settings.py).
API_CORS_ORIGENES=

# Desde donde se puede entrar: este computador y los equipos de Tailscale.
# El wifi de la casa queda fuera. Para abrir otra red, agregarla aca
# (separadas por coma). Ver api/seguridad.py.
# REDES_PERMITIDAS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48

# --- Limites de carga -------------------------------------------------------
MAX_MB_PDF=25
MAX_MB_IMAGEN=15
